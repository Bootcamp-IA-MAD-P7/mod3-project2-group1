# Copiar a .env (raíz) o exportar en el entorno. Nunca commitear .env real.
# Solo variables públicas; los secretos reales (API keys, user/pass) van en
# secretos del CI o del proveedor, nunca en este fichero.
#
# Valores por defecto seguros: sin datos reales, sin claves, sin servicios activos.

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO

# Ruta al bundle de modelo aprobado. Sin default que simule modelo:
# si se deja vacía, readiness no está disponible (no afecta liveness).
MODEL_PATH=

# Persistencia: deshabilitada para Essential. Activar solo con configuración válida.
PERSISTENCE_ENABLED=false
# Solo backend. Ejemplo documental, NO usar estas credenciales.
DATABASE_URL=

# Capacidades opcionales deshabilitadas por defecto.
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=

# CORS: lista explícita de orígenes permitidos (frontend local de desarrollo).
CORS_ORIGINS=http://localhost:5173

# --- Frontend (solo variables públicas VITE_*) ---
# URL base desde el navegador hacia la API.
VITE_API_BASE_URL=http://localhost:8000/api/v1