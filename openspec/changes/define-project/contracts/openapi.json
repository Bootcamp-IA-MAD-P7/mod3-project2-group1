  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z_]+$"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "reason"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "request_id",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "LiveResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "alive"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "model_version": {
            "type": "string"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "prediction": {
                "const": true
              },
              "video_analysis": {
                "type": "boolean"
              },
              "monitoring": {
                "type": "boolean"
              },
              "persistence": {
                "type": "boolean"
              }
            },
            "required": [
              "prediction",
              "video_analysis",
              "monitoring",
              "persistence"
            ]
          }
        },
        "required": [
          "status",
          "model_version",
          "capabilities"
        ]
      },
      "PredictionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "\\S",
            "description": "Al menos un carácter no whitespace; no trim del contenido para inferencia."
          }
        },
        "required": [
          "text"
        ]
      },
      "PersistenceStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "disabled",
              "stored",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Prediction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prediction_id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "enum": [
              "hate",
              "non_hate"
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "score_kind": {
            "type": "string",
            "enum": [
              "calibrated_probability",
              "unavailable"
            ]
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "review_required": {
            "const": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "persistence": {
            "$ref": "#/components/schemas/PersistenceStatus"
          },
          "resource_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "prediction_id",
          "label",
          "score",
          "score_kind",
          "model_version",
          "review_required",
          "created_at",
          "persistence",
          "resource_token"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "score_kind": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        ]
      },
      "VideoAnalysisRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "youtube_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "max_comments": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "required": [
          "youtube_url"
        ]
      },
      "AnalysisAccepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued"
            ]
          },
          "resource_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "analysis_id",
          "status",
          "resource_token",
          "expires_at"
        ]
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "type": "string",
            "format": "uuid"
          },
          "video_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "partial",
              "failed"
            ]
          },
          "fetched_count": {
            "type": "integer",
            "minimum": 0
          },
          "analyzed_count": {
            "type": "integer",
            "minimum": 0
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hate": {
                "type": "integer",
                "minimum": 0
              },
              "non_hate": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "hate",
              "non_hate"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "stop_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "source_exhausted",
                  "limit_reached",
                  "quota_exceeded",
                  "upstream_error"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorEnvelope"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "analysis_id",
          "video_id",
          "status",
          "fetched_count",
          "analyzed_count",
          "counts",
          "truncated",
          "stop_reason",
          "error",
          "expires_at"
        ]
      },
      "CommentResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "comment_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          }
        },
        "required": [
          "comment_id",
          "text",
          "ordinal",
          "prediction"
        ]
      },
      "ResultPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/CommentResult"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "MonitorRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "youtube_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "max_comments": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 300,
            "maximum": 3600,
            "default": 300
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 300,
            "maximum": 86400,
            "default": 3600
          }
        },
        "required": [
          "youtube_url"
        ]
      },
      "MonitorAccepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "monitor_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "resource_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "monitor_id",
          "status",
          "resource_token",
          "expires_at"
        ]
      },
      "Monitor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "monitor_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "stopped",
              "completed",
              "failed"
            ]
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 300,
            "maximum": 3600
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "latest_analysis_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest_analysis_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorEnvelope"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "monitor_id",
          "status",
          "interval_seconds",
          "expires_at",
          "latest_analysis_id",
          "latest_analysis_token",
          "error"
        ]
      }
    },
    "securitySchemes": {
      "ResourceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Resource-Token",
        "description": "Token opaco de recurso; nunca query/logs."
      }
    }
  }
}
